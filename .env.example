# Deployed Google Apps Script Web App URL, ending in /exec.
# This is the only component that talks to Google Sheets. It is called from the
# Next.js server only, never from the browser.
GOOGLE_SCRIPT_URL=

# Password for the admin sign-in at /admin/login. Compared on the server and
# never sent to the browser. Must match SAMSON_ADMIN_PASSWORD in Apps Script
# Script Properties, because the server uses it to complete the adminLogin
# challenge that authorises admin API calls.
ADMIN_PASSWORD=

# Secret used to sign the admin session cookie. Falls back to ADMIN_PASSWORD
# when unset. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Menu and dashboard display settings.
LOW_STOCK_THRESHOLD=10
CURRENCY=₹
TIMEZONE=Asia/Kolkata
