# Copy this file to `.env.local` and fill in the real values.
#
# `.env.local` is gitignored. Nothing here is NEXT_PUBLIC_: these are read on the
# server by `lib/config.ts`, which imports "server-only", so none of it reaches
# the browser. Restart `npm run dev` after editing — they are read at server start.
#
# ADMIN_KEY and AUTH_SECRET are REQUIRED and have no built-in default, so the
# admin area is unavailable without them. Set them in Vercel too.

# The Apps Script Web App URL. Must end in /exec.
# Copy it from Apps Script -> Deploy -> Manage deployments -> Web app URL.
# This overrides googleScriptUrl in lib/config.ts, so redeploying never needs a
# source edit. Verify it with:  <url>?action=version
# A current deployment answers {"success":true,"version":"2.0.0","actions":{...}}
# Every deployment gets its own URL; an old URL keeps serving the old build.
# Optional — lib/config.ts falls back to the current v2 URL.
GOOGLE_SCRIPT_URL=

# REQUIRED. The admin key. MUST match the SAMSON_ADMIN_KEY script property in
# Apps Script -> Project Settings -> Script properties, or every admin request is
# refused with "Unauthorized admin request".
# It stays on the server: the app compares it at sign-in and attaches it to backend
# calls itself, so it is never sent to the browser or included in the client bundle.
ADMIN_KEY=

# REQUIRED. Signs the admin session cookie. Any long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be different from ADMIN_KEY. Changing it signs existing admins out.
AUTH_SECRET=
